 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      " ", "\"\<FinalVirusModel.wl\>\""}], "}"}], "]"}], "]"}], 
