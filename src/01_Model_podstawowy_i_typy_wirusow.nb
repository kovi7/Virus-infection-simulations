     RowBox[{"{", 
      RowBox[{"\"\<Model startowy.\>\"", ",", 
       " ", "\"\<Model wierniejszy biologiczne, ale nadal nieidealny.\>\""}], 
      "}"}]}], "\n", " ", "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", "\n", " ", 
