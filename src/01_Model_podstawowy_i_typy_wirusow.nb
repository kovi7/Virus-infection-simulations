Cell[CellGroupData[{

Cell["1. Prosty model: tylko zakazeni sasiedzi", "Section",ExpressionUUID->"325a1d06-9c32-c940-a149-d72ffa626de4"],

Cell["\<\
Model prosty ma tylko dyskretne stany komorek. Zakazenie zalezy od liczby \
zakazonych sasiadow. (Nie ma wolnych wirionow, dyfuzji ani fazy lag produkcji \
wirusa.)\
\>", "Text",
 CellChangeTimes->{{3.988545571242115*^9, 
  3.988545590468752*^9}},ExpressionUUID->"ef10757d-df41-bb46-8fc9-\
47a24d31c8f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"simple", " ", "=", " ", 
    RowBox[{"RunSimpleScenario", "[", "\n", "  ", 
     RowBox[{"\"\<SimpleBaseline\>\"", ",", "\n", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<InitialInfected\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<Seed\>\"", " ", "->", " ", "101"}]}], "|>"}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"AnimateResult", "[", 
  RowBox[{"simple", ",", " ", 
   RowBox[{"\"\<ShowVirus\>\"", " ", "->", " ", "False"}], ",", " ", 
   RowBox[{"\"\<ShowImmune\>\"", " ", "->", " ", "False"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"1a9e159d-7935-ff4b-bc35-b2453f0f9ac1"],

Cell[BoxData[
 RowBox[{"CompareInfectedPlot", "[", 
  RowBox[{"<|", 
   RowBox[{"\"\<prosty model\>\"", " ", "->", " ", "simple"}], "|>"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"0db0aea8-4572-5348-a0c6-f88b649d7f49"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2. Profile fenotypowe, szybki vs wolniejszy bardziej uszkadzajacy\
\>", "Section",
 CellChangeTimes->{{3.9885471159171257`*^9, 
  3.9885471162591076`*^9}},ExpressionUUID->"f974ac38-564c-3841-80ba-\
d5e006ed161f"],

Cell["\<\
Porownanie SARS-CoV-2 vs hantawirus, ale niekliniczne. SARS-CoV-2: profil \
szybki oraz mniej  oraz profil wolniejszy, bardziej uszkadzajacy.\
\>", "Text",
 CellChangeTimes->{
  3.98854578901186*^9, {3.9885470046009617`*^9, 
   3.9885470203593864`*^9}},ExpressionUUID->"296f1276-ddc9-d147-b571-\
0dd5d1e75e6b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vt", " ", "=", " ", 
   RowBox[{"ExperimentVirusTypes", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"vt", "[", "\"\<AnimationPhenotypes\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.9885471123107986`*^9, 3.9885471135357*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"610697c2-f3c7-1e41-b41f-782e20c7672c"],

Cell[BoxData[
 RowBox[{"vt", "[", "\"\<PlotPhenotypes\>\"", "]"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"cba728f9-92d2-d846-b50e-567755ccdf0c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Prosty model vs model zaawansowany", "Section",
 CellChangeTimes->{{3.9886407006778708`*^9, 3.988640713631261*^9}, {
  3.9886408468225403`*^9, 
  3.9886408470760193`*^9}},ExpressionUUID->"8ce4a12d-cfad-cb44-9ca5-\
3d006a09de04"],

Cell["\<\
Model zaawansowany nadal pokazujemy jako czytelna siatke komorek, ale pod \
spodem ma pola ciagle: V dla wolnych wirionow, C dla sygnalu chemotaktycznego \
i A dla przeciwcial (wi\:0119cej o tym w kolejnych notatnikach). W tym \
porownaniu odpornosc\.87 jest wylaczona, zeby skupic sie tylko na wirionach i \
dyfuzji.\
\>", "Text",
 CellChangeTimes->{
  3.988545852521509*^9},ExpressionUUID->"c4eb59b0-95ef-ac44-aa89-\
b31409b952f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Model prosty\>\"", ",", " ", "14", ",", " ", "Bold"}], 
        "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Model zaawansowany\>\"", ",", " ", "14", ",", " ", 
         "Bold"}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<Infekcja tylko od zakazonych sasiadow.\>\"", ",", 
       " ", "\"\<Infekcja przez sasiadow oraz przez wolne wiriony V(t,x,y).\>\
\""}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<Brak dyfuzji.\>\"", ",", 
       " ", "\"\<Wolne wiriony dyfunduja po siatce.\>\""}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<Brak fazy lag.\>\"", ",", 
       " ", "\"\<Komorka ma faze lag i wewnatrzkomorkowa replikacje \
