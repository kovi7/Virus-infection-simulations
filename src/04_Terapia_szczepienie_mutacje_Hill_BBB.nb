Notebook[{

Cell[CellGroupData[{
Cell["\<\
04. Terapia, szczepienie, dawkowanie, mutacje i funkcja Hilla\
\>", "Title",ExpressionUUID->"16f02df1-ce21-8046-8af9-a7564641a8cc"],

Cell["\<\
Ten notebook pokazuje zastosowanie modelu do scenariuszy leczniczych i \
immunologicznych. \
\>", "Text",
 CellChangeTimes->{
  3.9885487170859604`*^9},ExpressionUUID->"acfdbd5f-a734-9d44-bfc5-\
ebe10936236e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      " ", "\"\<FinalVirusModel.wl\>\""}], "}"}], "]"}], "]"}], 
  ";"}]], "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"6bc50cb3-babd-9642-bc26-ec7b63721f01"],

Cell[BoxData["\<\"FinalVirusModel.wl loaded. Use RunSimpleScenario, \
RunScenario or Experiment... functions.\"\>"], "Print",
 CellChangeTimes->{
  3.9886283006284943`*^9, 3.9886286254676723`*^9, 3.988631203787661*^9, 
   3.9886312855754433`*^9, 3.9886318612450867`*^9, 3.988740276424243*^9, {
   3.988740379045556*^9, 3.9887403830266943`*^9}, 3.988741018797717*^9, 
   3.988741807554147*^9},
 CellLabel->
  "During evaluation of \
In[106]:=",ExpressionUUID->"520329d4-f8d0-422a-98d7-903c67a733f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Leczenie", "Section",
 CellChangeTimes->{{3.9885517820512543`*^9, 
  3.9885517824434757`*^9}},ExpressionUUID->"d9e93eac-278a-0544-9624-\
49b305292d36"],

Cell["\<\
Lek zmniejsza produkcje nowych wolnych wirionow przez komorki zakazone i \
zabija zaka\:017cone kom\[OAcute]rki. Jest to uproszczony odpowiednik \
skutecznosci terapii w modelach kinetyki wirusowej.\
\>", "Text",
 CellChangeTimes->{{3.988553981628912*^9, 
  3.9885539902886276`*^9}},ExpressionUUID->"9382ea16-c086-ae4c-bb8d-\
47c696e936b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dv", " ", "=", " ", 
   RowBox[{"ExperimentDrugVaccination", "[", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.988603035807794*^9},
 CellLabel->"In[97]:=",ExpressionUUID->"2047815e-5d83-2944-a4e7-620648b42cf8"],

Cell[BoxData[
 RowBox[{"dv", "[", "\"\<AnimationDrug\>\"", "]"}]], "Input",
 CellChangeTimes->{
  3.988603035807794*^9},ExpressionUUID->"31276c66-7e83-48e9-92aa-\
e841f22b5640"],

Cell[BoxData[
 RowBox[{"dv", "[", "\"\<PlotDrug\>\"", "]"}]], "Input",
 CellLabel->
  "In[141]:=",ExpressionUUID->"e63f8276-e31b-1c4d-b22e-f4fbe9f7977e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Szczepienie", "Section",ExpressionUUID->"7cea90c8-f59f-c741-ae1f-a9149d50b8e6"],

Cell["\<\
Szczepienie modelujemy jako czesc komorek chronionych oraz poczatkowo wiekszy \
poziom przeciwcial. To uproszczenie, ale dobrze pokazuje efekt zmniejszenia \
puli komorek podatnych.\
\>", "Text",ExpressionUUID->"4d803e78-8039-0740-9127-21fbc31f201f"],

Cell[BoxData[
 RowBox[{"dv", "[", "\"\<AnimationVaccination\>\"", "]"}]], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"1a375669-a9a5-6841-84d8-5de982190d67"],

Cell[BoxData[
 RowBox[{"dv", "[", "\"\<PlotVaccination\>\"", "]"}]], "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"a429c23a-41af-fb44-84c1-19c0dbec8638"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Strategie dawkowania", "Section",ExpressionUUID->"ff30d2d5-17b6-424c-a278-4f75e65eaf7d"],

Cell["\<\
Porownujemy wczesna i pozna interwencje oraz dawke jednorazowa i cykliczna. \
Cykliczne dawkowanie moze utrzymywac skutecznosc leku w czasie, ale zalezy to \
od eliminacji leku.\
\>", "Text",ExpressionUUID->"59803989-2500-b048-a59c-c685e9d2269f"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "tu", " ", "trzeba", " ", "b\:0119dzie", " ", "odpali\[CAcute]", " ", 
    "jeszcze", " ", "raz"}], ",", " ", 
   RowBox[{
   "ale", " ", "mo\:017ce", " ", "zwi\:0119kszaj\:0105c", " ", "dawk\:0119", " ",
     "leku"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.9885553026894894`*^9, 
  3.988555317702486*^9}},ExpressionUUID->"43bd3975-6f2e-c648-927d-\
a6208c69b438"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dose", " ", "=", " ", 
   RowBox[{"ExperimentDosing", "[", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.98856640738625*^9},
 CellLabel->"In[45]:=",ExpressionUUID->"a582e80c-eaf5-0a4f-aaa1-f05de9323384"],

Cell[BoxData[
 RowBox[{"dose", "[", "\"\<AnimationEarlyLate\>\"", "]"}]], "Input",
 CellChangeTimes->{
  3.98856640738625*^9},ExpressionUUID->"59e6ed8d-1a54-4954-aae7-0068ac4c0690"],

Cell[BoxData[
 RowBox[{"dose", "[", "\"\<PlotEarlyLate\>\"", "]"}]], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"7b45b09c-975d-b24b-9892-8710838abb65"],

Cell[BoxData[
 RowBox[{"dose", "[", "\"\<AnimationSingleCyclic\>\"", "]"}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"cff7da51-aaf6-fb48-ae46-9ee4370a8588"],

Cell[BoxData[
 RowBox[{"dose", "[", "\"\<PlotSingleCyclic\>\"", "]"}]], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"59748708-0fa9-df47-bb14-0a1f11e43e85"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Mutacja i ucieczka immunologiczna", "Section",ExpressionUUID->"b98ca922-4859-a045-b084-090e70f79502"],

Cell["\<\
Mutant ma nizsza podatnosc na neutralizacje przez uk\[LSlash]ad \
odporno\:015bciowy.\
\>", "Text",
 CellChangeTimes->{{3.988548752076391*^9, 3.9885487536303577`*^9}, {
  3.9885517385007343`*^9, 
  3.9885517550145054`*^9}},ExpressionUUID->"e4acab09-2f24-ba46-9911-\
aa22b58fcff2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mut", " ", "=", " ", 
   RowBox[{"ExperimentMutation", "[", "]"}]}], ";"}], "\n", 
 RowBox[{"mut", "[", "\"\<Animation\>\"", "]"}]}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"443e07d6-f8ef-9a46-bb82-5bdacfb208e9"],

Cell[BoxData[
 RowBox[{"mut", "[", "\"\<Plot\>\"", "]"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"05433088-07d9-c149-9ead-73b8d96cdc3e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Heatmapa", "Section",
 CellChangeTimes->{{3.988554334052084*^9, 3.9885543382648315`*^9}, 
   3.988562057912745*^9},ExpressionUUID->"7b8fd8f4-9919-2b48-87aa-\
145f2206b3bf"],

Cell["\<\
Heatmapa pokazuje, jak skutecznosc i czas podania leku wplywaja na \
przezywalnosc tkanki. Niska skutecznosc/pozna interwencja = brak efektu, \
wysoka skutecznosc/wczesna interwencja = nasycenie. Kazdy punkt to srednia z \
wielu symulacji (rownoleglych), co zapewnia statystyczna stabilnosc wyniku.\
\>", "Text",
 CellChangeTimes->{3.988562056400882*^9, 
  3.9885906110107822`*^9},ExpressionUUID->"f3b53d75-263a-486e-8dae-\
3638f122f263"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hm", "=", 
   RowBox[{"ExperimentTherapyHeatmap", "[", "]"}]}], ";"}], "\n", 
 RowBox[{"hm", "[", "\"\<Plot\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.9885543474811687`*^9, 3.988554376327057*^9}, 
   3.988562036404359*^9, 3.988562114707673*^9, 3.988568858877285*^9, 
   3.9885903110193567`*^9, 3.988590353391532*^9, 3.988590470722744*^9, {
   3.988590699973536*^9, 3.988590713143878*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"f5fb87d2-6718-db4d-b4f1-2ba430b5b9fd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Funkcja Hilla", "Section",
 CellChangeTimes->{{3.988554322785486*^9, 
  3.9885543228497944`*^9}},ExpressionUUID->"7601a2d3-b3ca-ee42-916e-\
c019c6fcd476"],

Cell["\<\
Funkcja Hilla pokazuje nieliniowa i nasycajaca odpowiedz immunologiczna. Przy \
malym stezeniu wirusa odpowiedz jest slaba, przy srednim rosnie szybko, a \
przy duzym osiaga nasycenie.\
\>", "Text",ExpressionUUID->"d182f407-40d7-7b44-92d8-5650ad3a7295"],

Cell[BoxData[
 RowBox[{"HillFunctionManipulate", "[", "]"}]], "Input",
 CellChangeTimes->{{3.9886096743177423`*^9, 3.988609676234326*^9}},
 CellLabel->
  "In[373]:=",ExpressionUUID->"933b2bee-1492-1048-b5ee-cf09af8bc499"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eksp", " ", "=", " ", 
     RowBox[{"ExperimentHillImpact", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"eksp", "[", "\"\<PhasePlot\>\"", "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.988609595452261*^9, {3.9886097812069883`*^9, 3.988609784712297*^9}},
 CellLabel->
  "In[375]:=",ExpressionUUID->"cef1626b-eccd-489d-94c2-c825fc9a4ee9"],

