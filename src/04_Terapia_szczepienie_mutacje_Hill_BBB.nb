 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"eksp", "[", "\"\<InfectedPlot\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.9885547835323086`*^9, 3.9885547914637737`*^9}, {
   3.988608708265188*^9, 3.988608740797494*^9}, {3.9886089705863132`*^9, 
   3.98860897206945*^9}, 3.988609779378551*^9},
 CellLabel->
  "In[377]:=",ExpressionUUID->"85989e29-18f2-fb40-bf72-dd367c5a2c45"],

